<!-- A real root view is required for cutout padding applied at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">
    <ImageView
        android:id="@+id/transmitter_image"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/transmitter_frame"
        android:scaleType="fitCenter"
        android:contentDescription="@string/image_description"
        android:clickable="true" android:focusable="true" />
    <Button
        android:id="@+id/about_button" style="@style/HoloCubeButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="16dp"
        android:text="@string/about_us" android:visibility="gone" />
</FrameLayout>
